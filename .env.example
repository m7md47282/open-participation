# Copy to .env (scripts/deploy.sh does this for you and generates the keys).
# Never commit .env.

# Base URL put into share links and QR codes. To scan with a phone on the same Wi-Fi,
# use your computer's LAN address, for example http://192.168.1.20:3000
PUBLIC_BASE_URL=http://localhost:3000

# Host port the container is published on.
HOST_PORT=3000

# Two separate HMAC keys, at least 32 characters each. Generate with: openssl rand -hex 32
GRANT_SIGNING_KEY=
CDN_SIGNING_KEY=

# Optional tuning (defaults shown).
# CDN_URL_TTL_SECONDS=300
# GRANT_TTL_SECONDS=14400
# SESSION_IDLE_TIMEOUT_SECONDS=900
# REDEEM_LIMIT_PER_IP_PER_MINUTE=20
# REDEEM_LIMIT_PER_SHARE_PER_MINUTE=120
# TRUST_PROXY=1
